FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies (including standard tools required by external wrappers and PostgreSQL/Celery)
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    libpq-dev \
    libmagic1 \
    libmagic-dev \
    libxml2-dev \
    libxslt1-dev \
    libffi-dev \
    libssl-dev \
    curl \
    wget \
    git \
    nmap \
    && rm -rf /var/lib/apt/lists/*

# Copy and install dependencies
COPY requirements.txt .
RUN pip install --upgrade pip && pip install --no-cache-dir -r requirements.txt

# Copy source code and entrypoints
COPY . .
COPY entrypoint.worker.sh /entrypoint.worker.sh
RUN chmod +x /entrypoint.worker.sh

# Isolate Celery process and cap memory limits (200MB per child max)
CMD ["celery", "-A", "celery_app", "worker", "-l", "info", "--concurrency=4", "--max-memory-per-child=200000"]
